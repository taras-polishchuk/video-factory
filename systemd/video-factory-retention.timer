# Daily trigger for video-factory-retention.service.
# Install: copy both files to /etc/systemd/system/, then
#   systemctl daemon-reload
#   systemctl enable --now video-factory-retention.timer

[Unit]
Description=Daily Video Factory retention sweep

[Timer]
OnCalendar=*-*-* 03:15:00 UTC
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
