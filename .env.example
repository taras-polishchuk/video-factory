# Environment for Video Factory (API, web server, deploy/ops scripts).
# NEVER commit values. NEVER log values. NEVER include values in
# Video Pack manifests or fixtures.
#
# Every environment variable the code reads is listed here (OPS S2,
# A2 F-24). tests/test_ops_s2_deploy.py fails when code reads a
# VIDEO_FACTORY_* / VF_* / STRIPE_* variable (or any literal os.environ
# name) that is not in this file. Commented lines (# NAME=) are
# optional knobs with a safe default.
#
# Production values are NOT set from this file: docker-compose.production.yml
# sets the runtime config and secrets come from systemd LoadCredential=
# (systemd/secret-distribution.md).

# ─── Safety gate ─────────────────────────────────────────────────
# Set to "true" ONLY for opt-in live API tests. Default behavior is
# offline / mock-only. Live path also requires the budget cap below.
LIVE_PROVIDER_TESTS=false
# Second live gate: live adapters run only when this is also "true"
# (set after a successful smoke run).
SMOKE_TEST_PASSED=false

# Hard USD ceiling for any single live batch. Adapters refuse
# submit() if estimated cost exceeds this. (The production compose
# file sets 20 / 5.)
MAX_COST_PER_BATCH_USD=0

# Per-video USD ceiling.
MAX_COST_PER_VIDEO_USD=0

# ─── Paths ───────────────────────────────────────────────────────
# SQLite / SQLCipher database file and artifact storage root.
# Defaults: ./artifacts/video_factory.db and ./artifacts/storage.
# Containers: /data/video_factory.db and /data/storage.
# VIDEO_FACTORY_DB=./artifacts/video_factory.db
# VIDEO_FACTORY_STORAGE=./artifacts/storage

# ─── Runtime mode ────────────────────────────────────────────────
# In production, set VF_HTTPS=1 (or VIDEO_FACTORY_ENV=production) so the
# session cookie is issued with the Secure attribute.
VF_HTTPS=0
VIDEO_FACTORY_ENV=dev
# Public https base URL: Stripe success/cancel and OIDC redirect URLs.
# Defaults to http://localhost (dev). Production: https://<domain>.
VIDEO_FACTORY_PUBLIC_BASE_URL=
# Dev-only escape hatch: return verify/reset tokens in HTTP responses.
# Ignored unless VIDEO_FACTORY_ENV is dev/test. Never set in production.
# VIDEO_FACTORY_DEV_EXPOSE_TOKENS=0

# ─── Keys (Wave 1 / Wave 5) ──────────────────────────────────────
# 32-byte hex secret used to derive the session CSRF token and sign the
# session cookie payload. Generate with
# `python -c "import secrets; print(secrets.token_hex(32))"`.
# Auth endpoints return 503 until this is set. The web server needs the
# same value (logout / workspace switch CSRF helper).
VIDEO_FACTORY_SESSION_SECRET=
# Fernet key for the per-company credential vault. Generate with
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`.
VIDEO_FACTORY_SECRET_KEY=
# SQLCipher page key. Set = the DB is encrypted at rest (production).
# Unset = plaintext dev DB. Rotate via POST /api/v1/admin/keys/rotate
# (docs/operations-prod.md).
VIDEO_FACTORY_DB_KEY=

# ─── Auth tuning (advanced) ──────────────────────────────────────
# Argon2 cost parameters (defaults are sane for offline tests).
# VF_ARGON2_TIME_COST=2
# VF_ARGON2_MEMORY_COST=19456
# VF_ARGON2_PARALLELISM=1

# Login rate-limit knobs (default = 5/IP/15min, 10/email/hour).
# VF_LOGIN_IP_LIMIT=5
# VF_LOGIN_IP_WINDOW_SEC=900
# VF_LOGIN_EMAIL_LIMIT=10
# VF_LOGIN_EMAIL_WINDOW_SEC=3600

# ─── OIDC sign-in (Wave 4, optional) ─────────────────────────────
# A provider is enabled when its client id + secret are set.
# GOOGLE_OIDC_CLIENT_ID=
# GOOGLE_OIDC_CLIENT_SECRET=
# GOOGLE_OIDC_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
# GITHUB_OIDC_CLIENT_ID=
# GITHUB_OIDC_CLIENT_SECRET=
# GITHUB_OIDC_DISCOVERY_URL=

# ─── Stripe billing (Wave 6) ─────────────────────────────────────
# Secret API key (sk_test_... in dev, sk_live_... in production).
STRIPE_SECRET_KEY=
# Webhook signing secret from the Stripe Dashboard (Developers
# → Webhooks → <endpoint> → Signing secret).  Required at boot
# for the /api/v1/webhooks/stripe endpoint to register.  In
# production this MUST be set to the real ``whsec_...`` value;
# in tests set it to a known ``whsec_test_...`` value and use
# ``stripe.Webhook.construct_event`` to build matching signatures.
STRIPE_WEBHOOK_SECRET=
# Price IDs per plan (A2 F-24: ONE name, used by checkout AND the
# webhook plan mapping). A subscription with the enterprise price id
# upgrades the workspace to ``enterprise``; any other maps to ``pro``.
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
# DEPRECATED names, still read (canonical name wins), logged as a
# deprecation warning. Rename them to the two above.
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_ENTERPRISE=

# ─── Observability (Wave 8) ──────────────────────────────────────
# Sentry DSN. Empty = Sentry off.
SENTRY_DSN=

# ─── HeyGen direct ────────────────────────────────────────────────
# HeyGen API key. Used only by the heygen_direct render profile.
HEYGEN_API_KEY=
# Optional webhook signing secret; if set, incoming webhooks are
# HMAC-verified before state transitions are honored.
HEYGEN_WEBHOOK_SECRET=
# Optional polling interval seconds (default 5).
HEYGEN_POLL_INTERVAL_SEC=5

# ─── ComfyUI Cloud ───────────────────────────────────────────────
# Comfy Cloud API base (e.g. https://api.comfy.org or your tenant).
COMFY_CLOUD_API_BASE=
COMFY_CLOUD_API_KEY=
# Optional concurrency cap; default 1.
COMFY_CLOUD_MAX_CONCURRENCY=1

# ─── ComfyUI GPU worker (rented VPS) ─────────────────────────────
# Base URL of the running ComfyUI server, e.g.
# https://comfy.example.com or http://100.x.y.z:8188
COMFY_GPU_API_BASE=
# Optional Basic auth user/pass if the server is exposed behind one.
COMFY_GPU_USER=
COMFY_GPU_PASSWORD=
# If true, the adapter may issue /free and /queue commands on
# shutdown. If false, only manual teardown is allowed.
COMFY_GPU_ALLOW_ACTIONS=true

# ─── ComfyUI HeyGen Partner Node profile (separate from heygen_direct) ─
# Set to "true" ONLY after verifying that the Comfy server object_info
# exposes HeyGen partner node types. Adapters detect this dynamically.
COMFY_HEYGEN_PARTNER_ENABLED=false

# ─── Publishing ──────────────────────────────────────────────────
# Publer API key (single-tenant env fallback of the credential vault).
# PUBLER_API_KEY=

# ─── Object storage for outputs ──────────────────────────────────
# NOT READ by the code yet (A2 F-07): the storage root is
# VIDEO_FACTORY_STORAGE; retention is not enforced yet.
ARTIFACTS_ROOT=./artifacts
ARTIFACTS_RETENTION_DAYS=30

# ─── Web server (SvelteKit adapter-node, web/) ───────────────────
# Where server-side fetches reach the API. Compose: http://api:8000.
# VIDEO_FACTORY_API_URL=http://127.0.0.1:8000
# adapter-node runtime (set by docker-compose.production.yml):
# ORIGIN=https://video.example.com
# BODY_SIZE_LIMIT=1M
# HOST=0.0.0.0
# PORT=3000

# ─── Deploy / ops (compose, systemd, scripts/*.sh) ───────────────
# These are read by docker compose, deploy scripts and systemd helpers,
# not by the Python app. See docs/operations-prod.md.
# docker-compose.production.yml (via /etc/video-factory/config.env):
# VIDEO_FACTORY_DOMAIN=video.example.com
# VIDEO_FACTORY_IMAGE_TAG=dev
# VIDEO_FACTORY_CADDYFILE=/etc/video-factory/Caddyfile
# VF_NET_SUBNET=172.31.250.0/24
# FORWARDED_ALLOW_IPS=172.31.250.0/24     (uvicorn; compose sets it from VF_NET_SUBNET)
# scripts/deploy.sh + provision-and-deploy.sh (deployer machine):
# HETZNER_TOKEN=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# ADMIN_CIDR=203.0.113.7/32
# ALLOW_OPEN_SSH=0
# ALLOW_DESTROY=0
# APPLY=0
# ACME_EMAIL=
# HCLOUD_SERVER_TYPE=cx22
# HCLOUD_LOCATION=fsn1
# VIDEO_FACTORY_SERVER_IP=                (written by provision-and-deploy.sh)
# systemd/video-factory-load-env.sh + scripts/remote-bootstrap.sh:
# VIDEO_FACTORY_CONFIG_FILE=/etc/video-factory/config.env
# VF_SRC_DIR=/opt/video-factory
# scripts/backup.sh / restore.sh (server, /etc/video-factory/backup.env):
# RESTIC_REPOSITORY=s3:s3.amazonaws.com/<bucket>/video-factory
# RESTIC_PASSWORD=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# RESTIC_RETENTION_DAYS=30
# VF_BACKUP_STAGING=/var/backups/video-factory
# VF_COMPOSE_FILE=/opt/video-factory/docker-compose.production.yml
# VF_COMPOSE_PROJECT=video-factory
# VF_COMPOSE_ENV_FILE=/opt/video-factory/.env.production
# scripts/dns-01-tls-bootstrap.sh (optional DNS-01 preflight):
# VF_CADDY_IMAGE=video-factory-caddy:tls-bootstrap   (prebuilt image, else built from infra/caddy)
# VF_TLS_WAIT=120                                    (seconds to wait for the cert)
# CADDY_DATA_DIR=
# scripts/start-local.sh:
# VIDEO_FACTORY_PYTHON=
