# Server-side secrets for Video Factory live renderers.
# NEVER commit values. NEVER log values. NEVER include values in
# Video Pack manifests or fixtures.
#
# All variables are read at submit() time via SecretProvider.
# Mock renderer ignores these. Live renderers raise ProviderDisabled
# unless LIVE_PROVIDER_TESTS=true AND budget caps are configured.

# ─── Safety gate ─────────────────────────────────────────────────
# Set to "true" ONLY for opt-in live API tests. Default behavior is
# offline / mock-only. Live path also requires the budget cap below.
LIVE_PROVIDER_TESTS=false

# Hard USD ceiling for any single live batch. Adapters refuse
# submit() if estimated cost exceeds this.
MAX_COST_PER_BATCH_USD=0

# Per-video USD ceiling.
MAX_COST_PER_VIDEO_USD=0

# ─── HeyGen direct ────────────────────────────────────────────────
# HeyGen API key. Used only by the heygen_direct render profile.
HEYGEN_API_KEY=
# Optional webhook signing secret; if set, incoming webhooks are
# HMAC-verified before state transitions are honored.
HEYGEN_WEBHOOK_SECRET=
# Optional polling interval seconds (default 5).
HEYGEN_POLL_INTERVAL_SEC=5

# ─── ComfyUI Cloud ───────────────────────────────────────────────
# Comfy Cloud API base (e.g. https://api.comfy.org or your tenant).
COMFY_CLOUD_API_BASE=
COMFY_CLOUD_API_KEY=
# Optional concurrency cap; default 1.
COMFY_CLOUD_MAX_CONCURRENCY=1

# ─── ComfyUI GPU worker (rented VPS) ─────────────────────────────
# Base URL of the running ComfyUI server, e.g.
# https://comfy.example.com or http://100.x.y.z:8188
COMFY_GPU_API_BASE=
# Optional Basic auth user/pass if the server is exposed behind one.
COMFY_GPU_USER=
COMFY_GPU_PASSWORD=
# If true, the adapter may issue /free and /queue commands on
# shutdown. If false, only manual teardown is allowed.
COMFY_GPU_ALLOW_ACTIONS=true

# ─── Object storage for outputs ──────────────────────────────────
# Default = local disk under artifacts/. Provider-aware adapters may
# override with S3/GCS/etc. namespacing.
ARTIFACTS_ROOT=./artifacts
ARTIFACTS_RETENTION_DAYS=30

# ─── ComfyUI HeyGen Partner Node profile (separate from heygen_direct) ─
# Set to "true" ONLY after verifying that the Comfy server object_info
# exposes HeyGen partner node types. Adapters detect this dynamically.
COMFY_HEYGEN_PARTNER_ENABLED=false

# ─── Auth (Wave 1) ─────────────────────────────────────────────
# 32-byte hex secret used to derive the session CSRF token and
# (in Wave 2) sign the session cookie payload. Generate with
# `python -c "import secrets; print(secrets.token_hex(32))"`.
# Auth endpoints return 503 until this is set.
VIDEO_FACTORY_SESSION_SECRET=

# In production, set this to "1" (or set VIDEO_FACTORY_ENV=production)
# so the session cookie is issued with the Secure attribute.
VF_HTTPS=0
VIDEO_FACTORY_ENV=dev

# Argon2 cost parameters (advanced; defaults are sane for offline tests).
# VF_ARGON2_TIME_COST=2
# VF_ARGON2_MEMORY_COST=19456
# VF_ARGON2_PARALLELISM=1

# Login rate-limit knobs (advanced; default = 5/IP/15min, 10/email/hour).
# VF_LOGIN_IP_LIMIT=5
# VF_LOGIN_IP_WINDOW_SEC=900
# VF_LOGIN_EMAIL_LIMIT=10
# VF_LOGIN_EMAIL_WINDOW_SEC=3600

# ─── Stripe billing (Wave 6c) ──────────────────────────────────
# Webhook signing secret from the Stripe Dashboard (Developers
# → Webhooks → <endpoint> → Signing secret).  Required at boot
# for the /api/v1/webhooks/stripe endpoint to register.  In
# production this MUST be set to the real ``whsec_...`` value;
# in tests set it to a known ``whsec_test_...`` value and use
# ``stripe.Webhook.construct_event`` to build matching signatures.
STRIPE_WEBHOOK_SECRET=
# Optional: when set, a subscription with this price id upgrades
# the workspace to the ``enterprise`` plan on
# customer.subscription.updated.  Any other price id maps to
# ``pro``.  Leave empty in the dev sandbox — the default is fine.
STRIPE_PRICE_ENTERPRISE=